{
  "name": "invoice-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sitemap.mjs",
    "preview": "npx --yes serve@14 out -l 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "size": "node scripts/measure-first-paint.mjs",
    "check:sitemap": "node scripts/build-sitemap.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "playwright test",
    "build:fonts": "node scripts/build-pdf-fonts.mjs",
    "build:og": "node scripts/build-og-image.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsqr": "^1.4.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
